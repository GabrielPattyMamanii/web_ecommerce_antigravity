  {
   "id": "e00304691",
   "type": "text",
   "x": 8,
   "y": 2157.75,
   "width": 1504,
   "height": 122.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1628125505,
   "version": 1,
   "versionNonce": 1949086685,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Chequeo de consistencia (debe devolver 0 filas cuando todo esté sincronizado):\nSELECT e.id, e.codigo, e.cantidad_docenas, e.cant_docenas_copy,\n       e.cantidad_docenas - COALESCE(SUM(v.cantidad_docenas),0) AS esperado\nFROM entradas e LEFT JOIN ventas v ON v.entrada_id = e.id\nGROUP BY e.id HAVING e.cant_docenas_copy IS DISTINCT FROM\n       e.cantidad_docenas - COALESCE(SUM(v.cantidad_docenas),0);\n(No aplica a productos donde también se usó el escáner QR, que resta por otro camino.)",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 12,
   "containerId": "e21790590",
   "originalText": "Chequeo de consistencia (debe devolver 0 filas cuando todo esté sincronizado):\nSELECT e.id, e.codigo, e.cantidad_docenas, e.cant_docenas_copy,\n       e.cantidad_docenas - COALESCE(SUM(v.cantidad_docenas),0) AS esperado\nFROM entradas e LEFT JOIN ventas v ON v.entrada_id = e.id\nGROUP BY e.id HAVING e.cant_docenas_copy IS DISTINCT FROM\n       e.cantidad_docenas - COALESCE(SUM(v.cantidad_docenas),0);\n(No aplica a productos donde también se usó el escáner QR, que resta por otro camino.)",
   "lineHeight": 1.25,
   "autoResize": true
  }
 ],
