   "text": "fetchDetails()  L46-96\n1) entradas .eq('tanda_nombre', tandaName)\n2) ventas .in('codigo', codes)\n         .eq('tanda_nombre', tandaName)\n3) soldMap[`${codigo}_${propietario}`] +=\n         Number(v.cantidad_docenas)\n\nCruce por TEXTO (codigo + propietario),\nno por entrada_id.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 11,
   "containerId": "e1187069",
   "originalText": "fetchDetails()  L46-96\n1) entradas .eq('tanda_nombre', tandaName)\n2) ventas .in('codigo', codes)\n         .eq('tanda_nombre', tandaName)\n3) soldMap[`${codigo}_${propietario}`] +=\n         Number(v.cantidad_docenas)\n\nCruce por TEXTO (codigo + propietario),\nno por entrada_id.",
   "lineHeight": 1.25,
   "autoResize": true
  },
