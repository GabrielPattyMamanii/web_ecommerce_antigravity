  },
  {
   "id": "e09542240",
   "type": "text",
   "x": 1148,
   "y": 1066.5,
   "width": 364,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 816606416,
   "version": 1,
   "versionNonce": 583509820,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Solo ventas nuevas hechas desde el celular.\nRequiere nueva build de la app (Expo).\nMientras tanto, las ventas móviles no descuentan.\nRiesgo: bajo.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 11,
   "containerId": "e04638539",
   "originalText": "Solo ventas nuevas hechas desde el celular.\nRequiere nueva build de la app (Expo).\nMientras tanto, las ventas móviles no descuentan.\nRiesgo: bajo.",
