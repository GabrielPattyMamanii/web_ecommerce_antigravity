   "roundness": null,
   "seed": 1870429817,
   "version": 1,
   "versionNonce": 1738108253,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "C. Ventas históricas con entrada_id NULL\nLa migración no hace backfill a propósito.\nEsas ventas no están reflejadas en cant_docenas_copy,\npero sí cuentan en SUM(ventas) (Registrar Ventas).",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 11,
   "containerId": "e53806743",
   "originalText": "C. Ventas históricas con entrada_id NULL\nLa migración no hace backfill a propósito.\nEsas ventas no están reflejadas en cant_docenas_copy,\npero sí cuentan en SUM(ventas) (Registrar Ventas).",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e27257545",
   "type": "rectangle",
   "x": 480,
   "y": 1203,
   "width": 630,
   "height": 190,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#b2f2bb",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1663482704,
   "version": 1,
   "versionNonce": 1641430417,
   "isDeleted": false,
   "boundElements": [
