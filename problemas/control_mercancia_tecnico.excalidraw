   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A. Doble descuento en Control de Mercancía\nControlMercanciaTanda.jsx:622-657 y 724-734\navailable = cant_docenas_copy - sold\nCon el trigger activo, copy ya tiene las ventas\nrestadas, y sold las vuelve a restar.\nEj: 10 docenas, vendo 3 -> copy=7, muestra 7-3=4.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 11,
   "containerId": "e74356427",
   "originalText": "A. Doble descuento en Control de Mercancía\nControlMercanciaTanda.jsx:622-657 y 724-734\navailable = cant_docenas_copy - sold\nCon el trigger activo, copy ya tiene las ventas\nrestadas, y sold las vuelve a restar.\nEj: 10 docenas, vendo 3 -> copy=7, muestra 7-3=4.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e68585029",
   "type": "rectangle",
   "x": 480,
   "y": 789,
   "width": 630,
   "height": 206,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#b2f2bb",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 445770841,
   "version": 1,
   "versionNonce": 971973171,
   "isDeleted": false,
   "boundElements": [
