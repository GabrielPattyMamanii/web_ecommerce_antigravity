  },
  {
   "id": "e76746738",
   "type": "text",
   "x": 488,
   "y": 1034.0,
   "width": 614,
   "height": 130.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
