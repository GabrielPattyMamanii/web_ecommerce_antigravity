     "id": "e48622446",
     "type": "text"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "e48622446",
   "type": "text",
   "x": 488,
   "y": 1216.75,
   "width": 614,
   "height": 162.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1695413425,
   "version": 1,
   "versionNonce": 1192975207,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1) Vista previa (solo lectura):\n  SELECT v.id, e.id FROM ventas v JOIN entradas e\n   ON e.codigo = v.codigo AND e.tanda_nombre = v.tanda_nombre\n   AND v.propietario = COALESCE(NULLIF(TRIM(e.propietario_producto),''),\n       NULLIF(TRIM(e.propietario),''),'Sin propietario')\n  WHERE v.entrada_id IS NULL;   -- quedarse solo con 1 match por venta\n2) UPDATE ventas SET entrada_id = ... solo para esos casos.\nATENCIÓN: el trigger UPDATE ya descuenta al pasar de NULL a un id.\nSi no se quiere descontar: ALTER TABLE ventas DISABLE TRIGGER\ntrg_ventas_reajusta_stock; hacer el UPDATE; volver a ENABLE.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 11,
   "containerId": "e27257545",
   "originalText": "1) Vista previa (solo lectura):\n  SELECT v.id, e.id FROM ventas v JOIN entradas e\n   ON e.codigo = v.codigo AND e.tanda_nombre = v.tanda_nombre\n   AND v.propietario = COALESCE(NULLIF(TRIM(e.propietario_producto),''),\n       NULLIF(TRIM(e.propietario),''),'Sin propietario')\n  WHERE v.entrada_id IS NULL;   -- quedarse solo con 1 match por venta\n2) UPDATE ventas SET entrada_id = ... solo para esos casos.\nATENCIÓN: el trigger UPDATE ya descuenta al pasar de NULL a un id.\nSi no se quiere descontar: ALTER TABLE ventas DISABLE TRIGGER\ntrg_ventas_reajusta_stock; hacer el UPDATE; volver a ENABLE.",
   "lineHeight": 1.25,
   "autoResize": true
  },
