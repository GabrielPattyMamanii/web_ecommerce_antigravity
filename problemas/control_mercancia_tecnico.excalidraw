   "text": "B. La app móvil no manda entrada_id\necommerce-mobile/stores/cartStore.ts:70-78\nrecords = items.map(({cuenta_id, ...item}) => ({...}))\ny hooks/useVentasHistorial.ts:138 (insert directo).\nentrada_id queda NULL -> el trigger hace IF ... IS NOT NULL\ny no descuenta.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 11,
   "containerId": "e13701535",
   "originalText": "B. La app móvil no manda entrada_id\necommerce-mobile/stores/cartStore.ts:70-78\nrecords = items.map(({cuenta_id, ...item}) => ({...}))\ny hooks/useVentasHistorial.ts:138 (insert directo).\nentrada_id queda NULL -> el trigger hace IF ... IS NOT NULL\ny no descuenta.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
