   "versionNonce": 503971938,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Bloquea ventas que hoy se permiten (ej. stock mal cargado).\nNOT VALID no revisa filas viejas; luego VALIDATE\nCONSTRAINT cuando se corrijan los negativos.\nRiesgo: medio.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 11,
   "containerId": "e16361155",
   "originalText": "Bloquea ventas que hoy se permiten (ej. stock mal cargado).\nNOT VALID no revisa filas viejas; luego VALIDATE\nCONSTRAINT cuando se corrijan los negativos.\nRiesgo: medio.",
   "lineHeight": 1.25,
   "autoResize": true
  },
