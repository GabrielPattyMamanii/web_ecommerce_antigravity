   "versionNonce": 504070682,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Modifica entradas.cant_docenas_copy y catalog_products.stock.\nSi copy ya fue ajustado a mano o con el escáner, se\ndescuenta dos veces.\nHacer backup (carpeta backups/) y probar en una tanda.\nRiesgo: alto si se automatiza.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 11,
   "containerId": "e18264547",
   "originalText": "Modifica entradas.cant_docenas_copy y catalog_products.stock.\nSi copy ya fue ajustado a mano o con el escáner, se\ndescuenta dos veces.\nHacer backup (carpeta backups/) y probar en una tanda.\nRiesgo: alto si se automatiza.",
   "lineHeight": 1.25,
   "autoResize": true
  },
