  {
   "id": "e61116462",
   "type": "text",
   "x": 488,
   "y": 1630.625,
   "width": 614,
   "height": 113.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
