  {
   "id": "e27571448",
   "type": "text",
   "x": 1148,
   "y": 1257.375,
   "width": 364,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
