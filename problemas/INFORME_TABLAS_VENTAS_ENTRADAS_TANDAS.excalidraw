        }
      ],
      "updated": 1792036692311,
      "created": 1792026583534,
      "link": null,
      "locked": false,
      "text": "Clave para traer ventas es : \"codigo + \"_\" + propietario + \"_\" + tanda_nombre\"\nBusca con esa clave todas las filas de la tabla \"ventas\" para luego calcular el stock\nrestante",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Clave para traer ventas es : \"codigo + \"_\" + propietario + \"_\" + tanda_nombre\"\nBusca con esa clave todas las filas de la tabla \"ventas\" para luego calcular el stock restante",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pYMrzypEChR0Eq2bi-9yp",
